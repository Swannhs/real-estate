{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "API Gateway",
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "endpoints": [
    {
      "endpoint": "/estate-api/public/v1/estates/recent-listings",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": [
        "limit"
      ],
      "input_headers": [
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/public/v1/estates/recent-listings",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/estate-api/public/v1/estates/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/public/v1/estates/{id}",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/estate-api/v1/estates/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/estates/{id}",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/estate-api/v1/estates",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/estates",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ],
      "input_headers": [
        "Authorization",
        "Content-Type"
      ]
    },
    {
      "endpoint": "/estate-api/v1/estates/{id}",
      "method": "PUT",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/estates/{id}",
          "encoding": "no-op",
          "sd": "static",
          "method": "PUT",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ],
      "input_headers": [
        "Authorization",
        "Content-Type"
      ]
    },
    {
      "endpoint": "/estate-api/v1/estates/{id}",
      "method": "DELETE",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/estates/{id}",
          "encoding": "no-op",
          "sd": "static",
          "method": "DELETE",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/estate-api/v1/estates",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/estates",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": [
            "http://localhost:8182"
          ],
          "disable_host_sanitize": false
        }
      ],
      "input_query_strings": [
        "page=1",
        "size=10",
        "orderBy=createdAt",
        "desc=desc"
      ]
    }
  ],
  "port": 8888
}